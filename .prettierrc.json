{
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 4,
    "plugins": ["prettier-plugin-solidity", "prettier-plugin-organize-imports"],
    "overrides": [
        {
            "files": "*.sol",
            "options": {
                "parser": "slang",
                "printWidth": 100,
                "tabWidth": 4,
                "useTabs": false,
                "singleQuote": false,
                "bracketSpacing": false
            }
        }
    ]
}
